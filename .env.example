# =============================================================================
# Bobby Elegance — environment variables
# =============================================================================
# Copy to `.env` and fill in. NEVER commit `.env`.
#
# IMPORTANT: the app runs fully WITHOUT any of these set. With no configuration
# it uses the in-memory mock data layer, a mock payment provider, and a mock
# shipping provider — which is exactly the development mode this repo ships in.
#
# Each block below is inert until you fill it in. Adding a real service is a
# matter of pasting keys here; no application code needs to change.
# =============================================================================


# -----------------------------------------------------------------------------
# Data layer
# -----------------------------------------------------------------------------
# Unset  -> in-memory seed data (default, zero setup)
# "prisma" -> real Postgres via DATABASE_URL
DATA_DRIVER=

# Supabase Postgres connection string (Supavisor transaction pooler, port 6543).
# Get it from: Supabase dashboard -> Project Settings -> Database -> Connection string
DATABASE_URL=
DIRECT_URL=


# -----------------------------------------------------------------------------
# Supabase (auth + file storage)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses row-level security — must never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=


# -----------------------------------------------------------------------------
# Payments — Razorpay
# -----------------------------------------------------------------------------
# Unset -> mock provider (checkout completes locally without a network call)
# Test keys start "rzp_test_", live keys "rzp_live_".
PAYMENT_PROVIDER=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# From: Razorpay dashboard -> Settings -> Webhooks. Used for HMAC verification.
RAZORPAY_WEBHOOK_SECRET=

# Cash on Delivery
COD_ENABLED=true
COD_MAX_ORDER_PAISE=2000000


# -----------------------------------------------------------------------------
# Shipping — Shiprocket
# -----------------------------------------------------------------------------
# Unset -> mock shipping (simulated rates and tracking events)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_WEBHOOK_TOKEN=
SHIPROCKET_PICKUP_LOCATION=Primary


# -----------------------------------------------------------------------------
# Email — Resend
# -----------------------------------------------------------------------------
# Unset -> emails are logged to the console instead of sent
RESEND_API_KEY=
EMAIL_FROM=orders@bobbyelegance.com
EMAIL_ADMIN=


# -----------------------------------------------------------------------------
# Rate limiting — Upstash Redis
# -----------------------------------------------------------------------------
# Unset -> in-memory limiter (fine for a single local process)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NODE_ENV=development
